# Полный стек (app + Prometheus/Grafana/Loki/Alloy/Tempo). Compose читает .env сам.
# Лёгкий режим: закомментируйте или COMPOSE_PROFILES=
COMPOSE_PROFILES=observability

# Опционально: прокси для HTTP-запросов к t.me (формат httpx)
# HTTP_PROXY=http://149.154.167.40:443
# HTTPS_PROXY=http://149.154.167.40:443

# --- Telethon (основной способ чтения каналов) ---
# Создайте приложение на https://my.telegram.org/apps
# Никому не отправляйте api_hash и не коммитьте .env и sessions/.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
# Номер при первой авторизации (как в Telegram, с + и кодом страны). Уменьшает ручной ввод в консоли:
TELEGRAM_PHONE=+79161234567
# Только для локальной машины — пароль облака Telegram (2FA), если включён:
# TELEGRAM_2FA_PASSWORD=

# --- OpenRouter (опционально, ai.enabled в config.yaml) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=https://github.com/your/repo
# OPENROUTER_APP_TITLE=jobdesk
# OPENROUTER_API_KEY=

# --- Пароли инфраструктуры docker compose (обязательны, дефолтных нет) ---
# Только [A-Za-z0-9_-]: пароли подставляются в DATABASE_URL / REDIS_URL без экранирования.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(24))"
# POSTGRES_PASSWORD и GRAFANA_ADMIN_PASSWORD применяются только при создании пустого тома;
# смена на существующем — см. комментарии у сервисов postgres и grafana в docker-compose.yml.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Нужен только с профилем observability; пустой или admin — Grafana не стартует.
GRAFANA_ADMIN_PASSWORD=

# --- Режим окружения ---
# dev (по умолчанию) — локальная разработка: регистрация открыта, тела HTTP пишутся
# в лог, JWT_SECRET необязателен. prod — регистрация закрыта после первого
# пользователя, тела в лог не пишутся, без JWT_SECRET (32+ символа) backend и
# воркеры не стартуют. Явно заданные AUTH_REGISTRATION_OPEN / HTTP_LOG_BODIES
# побеждают в обоих режимах.
# APP_ENV=dev
# Адрес публикации портов docker compose. По умолчанию 127.0.0.1 — стек доступен
# только с этой машины. 0.0.0.0 — открыть в сеть (только с APP_ENV=prod: в dev backend
# на не-loopback адресе не стартует, осознанно разрешить — ALLOW_PUBLIC_DEV=true):
# BIND_ADDR=127.0.0.1         # UI :5173 и API :9000
# INFRA_BIND_ADDR=127.0.0.1   # Postgres, Redis, Prometheus/Grafana/Loki/Alloy/Tempo

# --- Backend API (Docker / локально) ---
# Postgres и Redis с хоста — по 127.0.0.1, не localhost: порты опубликованы только на
# IPv4-loopback, а localhost сначала пробует ::1 (на Windows — ожидание до connect timeout).
# Без DATABASE_URL backend/CLI/alembic с хоста идут в Postgres из compose:
# tgjobs:<POSTGRES_PASSWORD>@127.0.0.1:5432/tgjobs. Внутри compose URL задан в docker-compose.yml.
# DATABASE_URL=postgresql+psycopg://tgjobs:<пароль>@127.0.0.1:5432/tgjobs
# Пул соединений на процесс. Пусто — по роли: API 20+20 (под 40 потоков sync-эндпоинтов),
# parse-worker 4+12, llm-worker и hh-worker 2+2. Считайте: сумма по всем процессам и
# репликам (--scale llm-worker=N) должна оставаться ниже max_connections Postgres (100).
# DB_POOL_SIZE=
# DB_MAX_OVERFLOW=
# Ожидание свободного соединения пула (сек). Пусто — API 5, воркеры 30.
# DB_POOL_TIMEOUT=
# Процесс API обрабатывает одновременно не больше запросов, чем у него соединений; остальные
# ждут столько секунд, затем 503 OVERLOADED (retryable). 0 — отклонять сразу.
# API_QUEUE_TIMEOUT_SECONDS=2
# Потолок строк экспорта (xlsx/JSON); сверх — обрезка с пометкой в файле и заголовком X-Export-Truncated.
# EXPORT_MAX_ROWS=50000
# Плановый бэкап (сервис pg-backup): pg_dump всей базы раз в BACKUP_INTERVAL_HOURS с
# проверкой восстановления; хранятся последние BACKUP_KEEP проверенных дампов.
# BACKUP_HOST_DIR — каталог на хосте (переживает down -v; копию вне машины — отдельно).
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
# BACKUP_HOST_DIR=./backup/pg
# API_HOST=127.0.0.1          # в compose — 0.0.0.0 внутри контейнера
# API_PORT=8000
# Адрес, на котором API доступен снаружи (compose передаёт BIND_ADDR). Пусто → API_HOST.
# В APP_ENV=dev не-loopback адрес — отказ старта; ALLOW_PUBLIC_DEV=true — только warning.
# API_PUBLIC_ADDR=
# ALLOW_PUBLIC_DEV=false
# /metrics backend'а — отдельный порт (не порт API); в compose только в Docker-сети. 0 — выключить.
# API_METRICS_PORT=9100
# METRICS_DB_STATS_CACHE_SECONDS=30   # кэш COUNT-агрегатов db_* между scrape
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Дополнительный X-API-Key поверх JWT (не замена логину):
# API_KEY=
# Подпись access-токенов. В dev без него — эфемерный секрет (сессии сгорают при
# рестарте); в prod обязателен. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# Access-токен короткий — UI продлевает его молча по refresh-cookie (httpOnly):
# JWT_TTL_MINUTES=15
# Срок refresh-сессии (скользящий: каждое продление отсчитывает заново):
# REFRESH_TTL_DAYS=30
# Флаг Secure у refresh-cookie; умолчание по APP_ENV (dev — false, prod — true, нужен HTTPS):
# REFRESH_COOKIE_SECURE=
# Лимиты /auth (0 — выключить): попыток входа/регистрации с одного IP в минуту и неудачных
# входов на email за окно — дальше 429 до конца окна. С REDIS_URL счётчики общие для процессов.
# AUTH_RATE_LIMIT_PER_MINUTE=20
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_FAILED_LOGIN_WINDOW_SECONDS=900
# Умолчание зависит от APP_ENV (dev — true, prod — false):
# AUTH_REGISTRATION_OPEN=true
# HTTP_LOG_BODIES=true
# Для frontend (Vite) при заданном API_KEY — тот же ключ (UI шлёт его заголовком X-API-Key):
# VITE_API_KEY=

# --- LLM jobs (Redis Queue). В Docker Compose по умолчанию rq + redis ---
# LLM_JOB_BACKEND=inprocess   # ThreadPool в API (локальные тесты / без Redis)
# LLM_JOB_BACKEND=rq
# REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:16379/0
# LLM_WORKER_METRICS_PORT=9101   # контейнерный порт; в compose не публикуется на хост (scale)
# LLM_JOB_STUCK_MINUTES=15
# LLM_JOB_LEASE_SECONDS=120      # heartbeat lease running LLM-джобы
# LLM_RQ_JOB_TIMEOUT_SECONDS=600
# JOB_RECOVER_INTERVAL_SECONDS=60  # периодический recover (помимо on-start): в worker, при inprocess — в API
# ANALYTICS_CACHE_SECONDS=30     # кэш агрегатов дашборда/аналитики в памяти API (сек); 0 — выключить
# LLM_USER_DAILY_CALLS=100       # суточная квота вызовов LLM на не-админа (мэтч, письма, импорт); 0 — без квоты
# LLM_JOB_MAX_ATTEMPTS=2         # после стольких попыток зависшая джоба → error вместо requeue

# --- Parse jobs (Redis Queue). В Docker Compose: rq + parse-worker ---
# PARSE_JOB_BACKEND=inprocess   # ThreadPool в API (локально без Redis)
# PARSE_JOB_BACKEND=rq
# PARSE_JOB_STUCK_MINUTES=30         # stale queued без живого RQ job
# PARSE_JOB_LEASE_SECONDS=120        # heartbeat lease running parse
# PARSE_JOB_MAX_ATTEMPTS=3           # после стольких попыток зависший прогон → failed вместо requeue
# PARSE_RQ_JOB_TIMEOUT_SECONDS=43200  # 12 ч; длинные прогоны Telethon
# PARSE_WORKER_METRICS_PORT=9102      # контейнерный порт; в compose не на хост

# --- HH sync jobs — настройки HH-сервиса (jobdesk_hh). В Docker Compose: rq + hh-worker ---
# HH_SYNC_JOB_BACKEND=inprocess      # поток в процессе HH-сервиса (локально без Redis)
# HH_SYNC_JOB_BACKEND=rq
# HH_SYNC_JOB_STUCK_MINUTES=15       # stale queued без живого RQ job
# HH_SYNC_JOB_LEASE_SECONDS=120      # heartbeat lease running sync
# HH_SYNC_JOB_MAX_ATTEMPTS=2         # после стольких попыток зависший sync → failed вместо requeue
# HH_SYNC_RQ_JOB_TIMEOUT_SECONDS=3600
# HH_WORKER_METRICS_PORT=9103        # контейнерный порт; в compose не на хост
# HH_SERVICE_PORT=8100               # API HH-сервиса (/v1/* для ядра, /health)
# HH_SERVICE_METRICS_PORT=9105       # /metrics процесса API HH-сервиса; 0 — не поднимать
# HH_MAINTENANCE_INTERVAL_SECONDS=3600  # очистка кэша выдачи и старых sync; 0 — выкл.
# CORE_INTERNAL_URL=http://127.0.0.1:8000  # ядро для HH-сервиса (в compose — http://backend:8000)

# --- Ядро ↔ HH-сервис ---
# HH_SERVICE_URL=http://127.0.0.1:8100  # пусто — /api/v1/hh/* отвечают 503 (в compose — http://hh-service:8100)
# Сервисные токены: пусто → общие dev-значения; в APP_ENV=prod обязательны, ≥32 символов.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# CORE_INTERNAL_TOKEN=               # ядро принимает от сервисов (/internal/v1)
# HH_SERVICE_TOKEN=                  # HH-сервис принимает от ядра (/v1)

# --- Фоновое обслуживание каталога: эмбеддинги, оценки зарплат, обзор и карта рынка ---
# В Docker Compose: worker + сервис maintenance-worker (задано в docker-compose.yml)
# MAINTENANCE_BACKEND=inprocess      # потоки лидера API (локально без воркера)
# MAINTENANCE_BACKEND=worker         # процесс jobdesk-maintenance-worker; задать и API, и воркеру
# MAINTENANCE_WORKER_METRICS_PORT=9104

# --- Liveness RQ-воркеров (heartbeat: цикл RQ + lease выполняемой джобы) ---
# WORKER_HEARTBEAT_MAX_AGE_SECONDS=180  # healthcheck unhealthy, если heartbeat старше
# WORKER_STALL_EXIT_SECONDS=900         # watchdog завершает зависший воркер (restart policy поднимет); 0 — выкл.

# --- HH.ru (admin sync; токен получаете вручную, например через dev.hh.ru) ---
# HH_API_TOKEN=
# HH_CONTACT_EMAIL=you@example.com
